# Copy to deploy/.env (git-ignored) on the machine that runs the service.

# Public hostname Traefik should route to the service.
LABEL_HOST=labels.example.com

# Swarm node that runs the Compose container. Defaults to this machine.
#LABEL_NODE=

# Image to run. Defaults to the one this repo's CI publishes.
#LABEL_IMAGE=ghcr.io/marco308/supvan-e11-mcp

# Comma-separated ESPHome Bluetooth proxies, "host" or "host|api_encryption_key".
SUPVAN_PROXIES=
